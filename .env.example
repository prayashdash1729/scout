# ── jobpilot env — copy the new keys below into your real .env ───────────

# Telegram (required)
TELEGRAM_BOT_TOKEN=123456:ABC-yourtoken
TELEGRAM_BOT_USERNAME=your_bot_username

# Gemini (required) — google.genai uses this API key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Jina (required) — used for both search (s.jina.ai) and reader (r.jina.ai)
JINA_API_KEY=jina_yourkey

# Database — for `docker compose`, this is set automatically for the bot
# container. Only set it here when running the bot OUTSIDE docker (e.g. local
# dev against a local postgres):
# DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot

# ── Access control & limits (all optional; sensible defaults applied) ────
# Allowlist — leave BOTH empty for open multi-user; fill either (or both) to
# lock the bot down. A user is allowed if they match EITHER list.
# Comma-separated numeric Telegram user IDs (stable, most secure).
ALLOWED_TELEGRAM_IDS=
# Comma-separated Telegram @usernames (convenient, but usernames can change and
# be reclaimed by someone else — prefer IDs for anything sensitive). '@' optional.
ALLOWED_TELEGRAM_USERNAMES=
# Minimum Gemini fit-score (0-10) for a job to be surfaced for approval.
SCORE_THRESHOLD=7
# Per-user /hunt cooldown (minutes) and daily cap.
HUNT_COOLDOWN_MINUTES=30
MAX_HUNTS_PER_DAY=10
# Hard ceiling on pages read+scored in a single hunt (protects your quota).
MAX_LINKS_PER_HUNT=40
# Links pulled per individual search query.
SEARCH_TOP_K=10
# Max distinct search queries per hunt (roles x cities x templates, capped).
MAX_QUERIES_PER_HUNT=24
# Concurrent page reads / scoring calls.
HUNT_CONCURRENCY=5
